{
  "manifest_version": 3,
  "name": "MultiTasker",
  "version": "0.1.0",
  "description": "Link browser tabs, such as AI chats and docs, to your MultiTasker tasks and get back to them in one click.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "MultiTasker",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
