{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiTasker",
  "identifier": "dev.wilsoon.multitasker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MultiTasker",
        "url": "index.html",
        "width": 880,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "widget",
        "title": "MultiTasker widget",
        "url": "widget.html",
        "width": 376,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "minWidth": 316,
        "maxWidth": 576,
        "minHeight": 60,
        "maxHeight": 916
      },
      {
        "label": "switcher",
        "title": "MultiTasker switcher",
        "url": "switcher.html",
        "width": 560,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dev.wilsoon.multitasker"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NjUyQzJDOTcyMEVFNzMKUldSejdpQ1hMQ3hsbFdqQS9UdzF3YWRGNmFkWUxXNExyOC9aNE9aWHBYeXVOYnFYTmZJMysxWHoK",
      "endpoints": [
        "https://github.com/Wilsoon7721/Multitasker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Wilsoon7721",
    "shortDescription": "Keeps the tasks you have in progress in front of you.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
